<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="blocks/submitparty/db" VERSION="2026041700" COMMENT="XMLDB file for block_submitparty"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd">
    <TABLES>
        <!-- En esta tabla guardo el historial minimo de celebraciones por usuario. -->
        <TABLE NAME="block_submitparty_log" COMMENT="Stores celebration clicks">
            <FIELDS>
                <!-- Clave primaria autoincremental para identificar cada fila. -->
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <!-- Usuario al que pertenece la entrega celebrada. -->
                <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
                <!-- Momento en que se registro la celebracion o la entrega. -->
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
                <!-- Bandera para saber si la animacion ya se mostro al usuario. -->
                <FIELD NAME="celebrated" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0"/>
                <!-- Texto libre para guardar una nota breve del evento. -->
                <FIELD NAME="message" TYPE="char" LENGTH="255" NOTNULL="false"/>
            </FIELDS>
            <KEYS>
                <!-- La clave primaria asegura la unicidad de cada registro. -->
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>
        </TABLE>
    </TABLES>
</XMLDB>
